{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kustomize": {
    "managerFilePatterns": [
      "/kustomization\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/velero/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>velero/velero-plugin-for-aws):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)",
        "image:\\s*(?<depName>velero/velero-plugin-for-csi):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*[\"']?(?<registryUrl>.*?)[\"']?\\s*\\n.*?chart:\\s*[\"']?(?<depName>.*?)[\"']?\\s*\\n.*?targetRevision:\\s*[\"']?(?<currentValue>.*?)[\"']?\\s"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:registry:\\s*(?<registry>[a-z0-9.-]+)\\s*\\n\\s*)?repository:\\s*(?<repo>[a-z0-9./-]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[\\w.-]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{#if registry}}{{registry}}/{{/if}}{{repo}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*(?<registryUrl>https://[^\\s]+)\\s*\\n\\s*chart:\\s*(?<depName>[\\w-]+)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>[\\w\\.\\-]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[a-z0-9\\-]+(?:\\/[a-z0-9\\-]+)+):(?<currentValue>v?[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "helmCharts:\\s*[- ]+name:\\s*(?<depName>.*?)\\s*\\n.*?repo:\\s*(?<registryUrl>.*?)\\s*\\n.*?version:\\s*(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v?[0-9].*?\\+rke2r[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rancher/rke2"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io/sdr-enthusiasts/[a-z0-9\\-]+):(?<currentValue>latest-build-[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io/[a-z0-9\\-]+/[a-z0-9\\-]+):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io/[a-z0-9\\-]+/[a-z0-9\\-]+):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[a-z0-9\\-]+(?:\\/[a-z0-9\\-]+)+):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "app\\.kubernetes\\.io/version:\\s*(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "longhorn/longhorn",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Immich server + ML (incl. the -cuda pin) tracked via GitHub releases: ghcr.io/immich-app has >20k PR/commit tags listed oldest-first, so the docker datasource's 20-page cap never reaches the release tags (lookup = no-result).",
      "managerFilePatterns": [
        "/^apps/media/immich/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/immich-app/immich-(?:server|machine-learning):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)",
        "name:\\s*ghcr\\.io/immich-app/immich-server\\s*\\n(?:\\s*#.*\\n)*\\s*newTag:\\s*[\"']?(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "immich-app/immich",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "helm"
      ],
      "groupName": "Helm chart updates",
      "automerge": false
    },
    {
      "matchManagers": [
        "docker"
      ],
      "automerge": false,
      "matchPackageNames": [
        "/^ghcr\\.io/.*/"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "SDR Enthusiasts container updates",
      "automerge": false,
      "matchPackageNames": [
        "ghcr.io/sdr-enthusiasts/{/,}**"
      ]
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "groupName": "Kustomize image updates",
      "automerge": false
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "groupName": "LinuxServer Kustomize image updates",
      "automerge": false
    },
    {
      "matchManagers": [
        "pip_requirements",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "congress-trades dependencies",
      "automerge": false
    },
    {
      "description": "Internal-registry images: registry.white.fm / registry.internal.white.fm are unreachable from hosted Renovate. Built and repinned manually.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.white.fm/**",
        "registry.internal.white.fm/**"
      ],
      "enabled": false
    },
    {
      "description": "Immich server/ML images are updated by the immich-app/immich github-releases regex manager; the GHCR tag list is too large for the docker datasource.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "enabled": false
    },
    {
      "description": "Postgres majors need pg_upgrade/dump-restore of the data volume first; never auto-bump them (condo postgres-0 crash-looped after 16 -> 18, 2026-09-16).",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres",
        "docker.io/postgres",
        "/^ghcr.io/immich-app/postgres$/",
        "/^tensorchord/pgvecto-rs$/",
        "/^pgvector/pgvector$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Synapse held at v1.160.0 until hookshot supports the stable MSC3202 device_id param (matrix-hookshot#1398). Remove this rule to resume updates.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "matrixdotorg/synapse",
        "docker.io/matrixdotorg/synapse"
      ],
      "enabled": false
    }
  ],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "robertdwhite",
      "password": "{{ secrets.GHCR_READ_TOKEN }}"
    }
  ]
}
