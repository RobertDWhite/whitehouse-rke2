    {
      "type": "table",
      "title": "Sources",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "ffbp5qeorery8b"
      },
      "description": "Time since each source last synced without error, and since its last error.",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ffbp5qeorery8b"
          },
          "expr": "time() - (brain_sync_last_success_timestamp_seconds > 0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ffbp5qeorery8b"
          },
          "expr": "time() - (brain_sync_last_error_timestamp_seconds > 0)",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "source",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true
            },
            "renameByName": {
              "source": "Source",
              "Value #A": "Last success",
              "Value #B": "Last error"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last success"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 1800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Source"
          }
        ]
      }
    },
