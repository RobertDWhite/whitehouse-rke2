        "definition": "label_values(external_dns_controller_last_sync_timestamp_seconds, controller)",
        "includeAll": true,
        "label": "Controller",
        "name": "Controller",
        "options": [],
        "query": "label_values(external_dns_controller_last_sync_timestamp_seconds, controller)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
