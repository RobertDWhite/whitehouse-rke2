      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT \"UserName\" AS \"User\",\n       CASE WHEN COALESCE(\"SeriesName\",'') <> '' THEN \"SeriesName\" || ' - ' || \"NowPlayingItemName\" ELSE \"NowPlayingItemName\" END AS \"Title\",\n       \"Client\", \"DeviceName\" AS \"Device\", \"PlayMethod\" AS \"Method\",\n       CASE WHEN \"IsPaused\" THEN 'paused' ELSE 'playing' END AS \"State\"\nFROM jf_activity_watchdog\nORDER BY \"ActivityDateInserted\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
