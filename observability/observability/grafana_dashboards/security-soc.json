{
  "uid": "security-soc",
  "title": "Security SOC",
  "tags": [
    "security",
    "soc",
    "siem"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active security detections",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "ffbp5qeorery8b"
      },
      "description": "Missing telemetry is a security alert. Empty results are meaningful only when source-health panels show coverage.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{security=\"true\",alertstate=\"firing\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffbp5qeorery8b"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Security alerts by category",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ffbp5qeorery8b"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category,severity) (ALERTS{security=\"true\",alertstate=\"firing\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "ffbp5qeorery8b"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Ubuntu syslog events by host",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "ffbp5mct1w0lcb"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate({job=\"syslog\",host=~\"rke2-node-.*\"}[5m]))",
          "datasource": {
            "type": "loki",
            "uid": "ffbp5mct1w0lcb"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Last 10 minutes: host heartbeats",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "ffbp5mct1w0lcb"
      },
      "description": "Expected nodes: 10,11,12,13,14,15,50. Missing rows are missing sources, not zero risk.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (count_over_time({job=\"syslog\"} |= \"SIEM_HEARTBEAT\" [10m]))",
          "datasource": {
            "type": "loki",
            "uid": "ffbp5mct1w0lcb"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Kubernetes audit coverage",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "ffbp5mct1w0lcb"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate({job=\"kube-audit\"}[5m]))",
          "datasource": {
            "type": "loki",
            "uid": "ffbp5mct1w0lcb"
          },
