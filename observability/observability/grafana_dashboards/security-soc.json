      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "ffbp5mct1w0lcb"
      },
      "description": "Initial differential snapshots establish the baseline. A new listening port or account is evidence to investigate, not automatically malicious.",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
