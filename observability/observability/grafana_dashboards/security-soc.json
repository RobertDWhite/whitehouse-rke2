    {
      "id": 7,
      "title": "Fleet endpoints reporting (15m)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "ffbp5mct1w0lcb"
      },
      "description": "Desktop/server Fleet agents only. iOS/iPadOS/watchOS/tvOS MDM devices cannot run osquery. Sleeping or offline endpoints may be absent.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (count_over_time({source_type=\"endpoint\",category=\"telemetry_health\"} |= \"soc_heartbeat\" | json endpoint=\"decorations.hostname\" | __error__=\"\" [15m]))",
          "datasource": {
            "type": "loki",
            "uid": "ffbp5mct1w0lcb"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
