      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (priority) (rate({source=\"syscall\"}[5m]))",
          "datasource": {
            "type": "loki",
