      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"kube-audit\"} | json resource=\"objectRef.resource\",subresource=\"objectRef.subresource\" | resource=~\"secrets|clusterrolebindings|rolebindings|clusterroles|roles\" or subresource=~\"exec|attach\"",
