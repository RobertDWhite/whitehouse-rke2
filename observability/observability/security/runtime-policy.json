[
  {
    "id": "immich-rsync",
    "rule": "Drop and execute new binary in container",
    "fields": {
      "k8s_ns_name": "immich",
      "k8s_pod_name": "immich-(photos-bidirectional-sync|upload-to-synology-sync)-[0-9]+-[a-z0-9]+",
      "container": "rsync",
      "image": "docker.io/library/alpine",
      "process": "rsync",
      "exe": "/usr/bin/rsync",
      "parent": "sh"
    },
    "owner": "Robert",
    "expires": "2026-12-11T00:00:00Z",
    "evidence": "Immich maintenance CronJobs explicitly install rsync before the additive backup sync."
  },
