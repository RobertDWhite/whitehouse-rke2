  {
    "id": "rke2-snapshot-log",
    "rule": "Clear Log Activities",
    "fields": {
      "container": "host",
      "process": "containerd",
      "exe": "/var/lib/rancher/rke2/data/v[0-9.]+-rke2r[0-9]+-[a-f0-9]+/bin/containerd",
      "parent": "rke2",
      "file": "/var/lib/rancher/rke2/agent/containerd/(io.containerd.snapshotter.v1.overlayfs/snapshots/[0-9]+/fs/(var/log/dpkg.log|etc/default/cron|etc/init.d/cron|etc/pam.d/cron|usr/sbin/cron)|tmpmounts/containerd-mount[0-9]+/var/log/dpkg.log)"
    },
    "owner": "Robert",
    "expires": "2026-12-11T00:00:00Z",
    "evidence": "Host RKE2 containerd image unpack/cleanup of dpkg and cron files in managed snapshots/tmpmounts; excludes host /var/log and all other files."
  },
  {
    "id": "nvidia-immich-ml-gpu",
    "rule": "Fileless execution via memfd_create",
    "fields": {
      "k8s_ns_name": "immich",
      "k8s_pod_name": "immich-ml-gpu-[a-z0-9]+-[a-z0-9]+",
      "container": "immich-ml",
      "image": "ghcr.io/immich-app/immich-machine-learning",
      "process": "memfd:runc_clon",
      "exe": "memfd:runc_cloned:ldconfig",
      "parent": "nvidia-ctk",
      "runtime_hook": "runc:\\[1:CHILD\\]"
    },
    "owner": "Robert",
    "expires": "2026-12-11T00:00:00Z",
    "evidence": "NVIDIA toolkit ldconfig hook in GPU workload; requires both runc child ancestry and nvidia-ctk parent."
  },
